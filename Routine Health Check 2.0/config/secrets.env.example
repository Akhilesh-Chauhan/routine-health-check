# Operator secrets for the dev AWS Cognito gate (spec D8).
#
# Copy this file to `config/secrets.env` (which is gitignored) and fill in the
# real values, OR export the same names in your environment. Real environment
# variables always take precedence over this file.
#
#   cp config/secrets.env.example config/secrets.env
#
# The dev Cognito username is non-secret and defaults to "devadmin" if unset.
HC_DEV_COGNITO_USER=devadmin
HC_DEV_COGNITO_PASS=Myscheme@3211

# UMANG Production API keys — client-side x-api-key values for the UMANG prod
# APIs monitored by the liveness sweep. Referenced from url_registry.json as
# ${UMANG_FACETS_KEY} / ${UMANG_SCHEMES_KEY}.
UMANG_FACETS_KEY=your-facets-api-key-here
UMANG_SCHEMES_KEY=your-schemes-api-key-here
